# ═══════════════════════════════════════════════════════════════════
# StarReview AI — Master Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# Never commit real API keys, secrets, or private keys to source control.
# ═══════════════════════════════════════════════════════════════════

# ---------- Application & General Settings ----------
PORT=5000
APP_URL=https://starreview-ai-alpha.vercel.app
JWT_SECRET=your-secure-jwt-secret-generate-with-openssl-rand-hex-32
ADMIN_EMAIL=team@maruti.com
CONTACT_PHONE=9904482945
WHATSAPP_NUMBER=919904482945

# ---------- MongoDB Database Configuration ----------
# Production connection string (e.g. MongoDB Atlas cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://starreview_admin:your_mongo_password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=starreview_ai

# ---------- Firebase Authentication (Frontend / Client) ----------
# Values obtained from Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=AIzaSyA_ExampleApiKeyPlaceholder
VITE_FIREBASE_AUTH_DOMAIN=starreview-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=starreview-ai
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ---------- Firebase Admin SDK (Backend Token Verification) ----------
# Values obtained from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=starreview-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@starreview-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ---------- OpenRouter AI (Review Drafts & Sentiment Replies) ----------
# Create key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
# Recommended high-performance models: meta-llama/llama-3.3-70b-instruct, google/gemini-2.0-flash-001, mistralai/mistral-small
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------- Razorpay Payment Gateway (Indian & Global Checkouts) ----------
# Obtain from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_key_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_webhook_signing_secret

# ---------- Google Cloud & Places API / OAuth 2.0 ----------
# Enabled APIs in Google Cloud Console: Places API (New), Business Profile Performance API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_and_places_api_key

# ---------- Optional Email & SMS Notifications ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=team@maruti.com
SMTP_PASS=your_google_app_password
MAIL_FROM="StarReview AI" <team@maruti.com>
NOTIFY_EMAIL=team@maruti.com
