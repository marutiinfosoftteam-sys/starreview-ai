# ---------- Required ----------
# Use a long random string. Never share it.
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000

# ---------- Public URL ----------
# Your website address after deployment, for example https://yourdomain.com
# QR codes use it. Leave empty while testing locally.
PUBLIC_URL=

# ---------- Razorpay payments ----------
# Dashboard -> Settings -> API Keys. Use rzp_test_... keys first, then rzp_live_... keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. URL: https://YOUR-DOMAIN/api/billing/webhook
# Events: payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---------- AI drafts and replies (optional) ----------
# Without a key the app uses built-in English templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Email notifications (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Receives contact form and platform feedback emails
NOTIFY_EMAIL=

# ---------- WhatsApp (optional) ----------
# Your business number with country code and no plus sign, for example 919876543210.
# Used for the WhatsApp QR code and the Chat on WhatsApp button.
WHATSAPP_NUMBER=
# Optional alerts through the Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NOTIFY_TO=
