# ═══════════════════════════════════════════════════════════════════
# StarReview AI — Environment Configuration Template
# Copy this file to .env and fill in only the values you have.
#
# IMPORTANT: leave a line empty if you don't have a real value yet.
# Any non-empty value switches that feature ON, so a fake placeholder
# (e.g. a sample MongoDB URL) makes the feature fail instead of
# falling back to the built-in local mode.
#
# Never commit .env or real keys to GitHub.
# ═══════════════════════════════════════════════════════════════════

# ---------- Application ----------
# API server port. 5050 avoids macOS AirPlay, which uses port 5000.
# The website's dev server (npm run dev) reads this too, so they stay in sync.
PORT=5050
APP_URL=https://starreview-ai-alpha.vercel.app
# Public site URL encoded in QR codes (leave empty on localhost)
PUBLIC_URL=
# Long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=
# This account gets admin rights after signing in
ADMIN_EMAIL=marutiinfosoftteam@gmail.com
CONTACT_PHONE=+919904482945
WHATSAPP_NUMBER=919904482945

# ---------- Google business search (onboarding) — recommended ----------
# Empty = search still works across India using OpenStreetMap (free, no key), but it
# finds fewer businesses and has no phone, rating or Google review link.
# With a key, results come from Google Maps: exact address, PIN, phone, rating, review link.
# Google Cloud Console → APIs & Services → enable "Places API (New)" → create an API key.
# Billing must be enabled on the Google Cloud project.
# Server-side only: never prefix with VITE_.
GOOGLE_PLACES_API_KEY=

# ---------- MongoDB (needed on Vercel so accounts are not lost) ----------
# Empty = data is stored in server/data/store.json. That is fine on your own computer,
# but Vercel's disk is temporary: without MongoDB, sign-ups disappear after a while
# and those people can no longer sign in. Free cluster: https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=starreview_ai

# ---------- Firebase Google sign-in ("Sign in with Google") ----------
# Firebase Console → Project Settings → General → Your apps
# Also: Authentication → Sign-in method → enable Google, and
# Authentication → Settings → Authorized domains → add starreview-ai-alpha.vercel.app
# The server checks every Google sign-in with Google using VITE_FIREBASE_API_KEY.
# Without these values the Google button says sign-in is not available (no fake logins).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console → Project Settings → Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- AI review drafts (optional) ----------
# Empty = built-in draft templates are used. Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------- Razorpay (payments are demo-only in this build) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Google OAuth (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email ("Delete account" requests reach marutiinfosoftteam@gmail.com) ----------
# Works without SMTP: requests go through FormSubmit (formsubmit.co, free, no key).
# ONE-TIME STEP: after the first request, FormSubmit sends an "Activate Form" email
# to marutiinfosoftteam@gmail.com. Open it and click Activate. From then on every
# request arrives in that inbox. (Set FORMSUBMIT=off to turn this off.)
#
# Optional, to send from your own Gmail instead: turn on 2-Step Verification, create
# an App Password (Google Account → Security → App passwords) and paste it in SMTP_PASS.
FORMSUBMIT=on
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=marutiinfosoftteam@gmail.com
SMTP_PASS=
MAIL_FROM="StarReview AI" <marutiinfosoftteam@gmail.com>
NOTIFY_EMAIL=marutiinfosoftteam@gmail.com
